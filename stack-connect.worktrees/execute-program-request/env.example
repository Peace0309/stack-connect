
POSTGRES_USER=ps101
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ps101
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://ps101:change-me@localhost:5432/ps101

# --- Backend --------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- AI (optional; platform falls back to the offline generator) -----
AI_PROVIDER=lovable            # lovable | openai | offline
LOVABLE_API_KEY=your-lovable-ai-gateway-key
AI_MODEL=google/gemini-3.8-flash
OPENAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Mock iGOT Karmayogi service ------------------------------------
IGOT_MODE=mock                 # mock | live
IGOT_BASE_URL=http://localhost:8000/api/igot
IGOT_API_KEY=not-required-in-mock-mode

# --- Frontend -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
